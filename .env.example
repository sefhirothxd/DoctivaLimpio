# Copia este archivo como `.env`.
#
# URL base del backend (Express + Sequelize).
# - Desarrollo: déjala como /api; Vite la reenvía a VITE_DEV_API_TARGET (ver vite.config.ts).
# - Producción: URL completa del API, p. ej. https://api.doctiva.app/api
VITE_API_URL="http://localhost:3001/api"

# Solo desarrollo: dónde corre tu backend local.
VITE_DEV_API_TARGET=http://localhost:3000
